#!/bin/bash

#SBATCH --output="job_outputs/%x.out"
#SBATCH --error="job_outputs/%x.err"
#SBATCH --exclude=n[33]
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=5G
#SBATCH --partition=cpu
#SBATCH --time=24:00:00

DOMAIN=${1}
PROBLEM_SIZE=${2}
NODE_DEGREE=${3}

LOSS=${4}
REGULARIZATION=${5}
ACTIVATION=${6}
TEMP_SCHEDULE=${7}
INVERSED_TEMP=${8}
EXPERIMENT_NAME=${9}


RANDOM_SEEDS=5
DATA_SIZE=20

source venv/bin/activate

echo "Running training script"
export PYTHONPATH=/home/krutsma1/gnn-comb-opt:$PYTHONPATH
python -u scripts/run.py --rnd_seeds $RANDOM_SEEDS --domain "$DOMAIN" --problem_size $PROBLEM_SIZE --node_degree $NODE_DEGREE --data_size $DATA_SIZE --loss "$LOSS" --regularization "$REGULARIZATION" --activation "$ACTIVATION" --temp_schedule "$TEMP_SCHEDULE" --inversed_temp $INVERSED_TEMP --experiment_name "$EXPERIMENT_NAME"
